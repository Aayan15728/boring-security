{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boring-security/findings.schema.json",
  "title": "boring-security findings.json",
  "description": "Array of verified records, each exactly one of confirmed, needs_validation, rejected. scripts/check-findings.cjs validates against this file directly (x-visible: must contain visible text; x-relpath: safe repository-relative path).",
  "type": "array",
  "maxItems": 1000,
  "items": {
    "oneOf": [
      {
        "$ref": "#/$defs/confirmed"
      },
      {
        "$ref": "#/$defs/needs_validation"
      },
      {
        "$ref": "#/$defs/rejected"
      }
    ]
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "x-visible": true
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "relpath": {
      "type": "string",
      "x-relpath": true,
      "description": "Repository-relative, forward slashes, no '.', '..', empty, absolute or drive segments."
    },
    "fingerprint": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "description": "Stable, source-derived root-cause id. No line numbers, wave, agent, severity or verdict."
    },
    "level": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "rated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "why"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "why": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "description": "One step: entrypoint or sink. Several: entrypoint first, sink last, propagation between.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "file",
          "line",
          "quote",
          "scope",
          "note"
        ],
        "properties": {
          "step": {
            "enum": [
              "entrypoint",
              "propagation",
              "sink"
            ]
          },
          "file": {
            "$ref": "#/$defs/relpath"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-visible": true,
            "description": "Verbatim excerpt of the cited source line(s); check-findings --target confirms it appears within 2 lines of `line`."
          },
          "scope": {
            "$ref": "#/$defs/text",
            "description": "Function, method, route, component or config key."
          },
          "note": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "quote",
          "note"
        ],
        "properties": {
          "file": {
            "$ref": "#/$defs/relpath"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "x-visible": true,
            "description": "Verbatim excerpt of the cited source line(s); check-findings --target confirms it appears within 2 lines of `line`."
          },
          "note": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "category": {
      "type": "string",
      "description": "Free-form class, e.g. access-control, mobile/exported-component."
    },
    "cwe": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      }
    },
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "fingerprint",
        "title",
        "description",
        "root_cause",
        "intended_behavior",
        "trace",
        "evidence",
        "conditions",
        "execution",
        "remediation",
        "severity",
        "confidence"
      ],
      "properties": {
        "verdict": {
          "const": "confirmed"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "root_cause": {
          "$ref": "#/$defs/text"
        },
        "intended_behavior": {
          "$ref": "#/$defs/text"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "note"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "authentication",
                  "authorization_role",
                  "user_interaction",
                  "configuration",
                  "network_position",
                  "device_state",
                  "data_state",
                  "timing",
                  "third_party"
                ]
              },
              "note": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attacker",
            "payloads",
            "steps",
            "observed_result"
          ],
          "properties": {
            "attacker": {
              "$ref": "#/$defs/text",
              "description": "Starting capability of the dummy attacker."
            },
            "payloads": {
              "$ref": "#/$defs/texts"
            },
            "steps": {
              "$ref": "#/$defs/text",
              "description": "Bounded reproduction through the target's native interface."
            },
            "observed_result": {
              "$ref": "#/$defs/text"
            },
            "evidence_files": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "x-relpath": true,
                "pattern": "^agents/[a-z0-9][a-z0-9_-]{0,63}/evidence/.+"
              }
            }
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "$ref": "#/$defs/text"
            },
            "code_changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "change"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/relpath"
                  },
                  "change": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "regression_test": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "likelihood",
            "impact",
            "overall"
          ],
          "description": "overall must not exceed impact.level (checked by the validator).",
          "properties": {
            "likelihood": {
              "$ref": "#/$defs/rated"
            },
            "impact": {
              "$ref": "#/$defs/rated"
            },
            "overall": {
              "$ref": "#/$defs/level"
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "why"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "why": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "cwe": {
          "$ref": "#/$defs/cwe"
        },
        "packs": {
          "$ref": "#/$defs/packs"
        }
      }
    },
    "needs_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "fingerprint",
        "title",
        "description",
        "claimed_root_cause",
        "trace",
        "evidence",
        "blockers",
        "validation_plan"
      ],
      "properties": {
        "verdict": {
          "const": "needs_validation"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "claimed_root_cause": {
          "$ref": "#/$defs/text"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "blockers": {
          "$ref": "#/$defs/texts"
        },
        "validation_plan": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "local": {
              "$ref": "#/$defs/text",
              "description": "Bounded sandboxed fixture or test that would settle it."
            },
            "deployment": {
              "$ref": "#/$defs/text",
              "description": "What an owner should observe (config, policy, identity, route). Never live probing."
            }
          }
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "cwe": {
          "$ref": "#/$defs/cwe"
        },
        "packs": {
          "$ref": "#/$defs/packs"
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "fingerprint",
        "title",
        "description",
        "claimed_root_cause",
        "trace",
        "evidence",
        "reason"
      ],
      "properties": {
        "verdict": {
          "const": "rejected"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "claimed_root_cause": {
          "$ref": "#/$defs/text"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "cwe": {
          "$ref": "#/$defs/cwe"
        },
        "packs": {
          "$ref": "#/$defs/packs"
        }
      }
    }
  }
}
