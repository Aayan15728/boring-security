{
  "name": "boring-security",
  "version": "0.4.0",
  "description": "Evidence-first security audits for Claude Code: agents hunt, a skeptic disproves, scripts verify every quote. Install with npx boring-security.",
  "keywords": [
    "claude-code",
    "claude",
    "skill",
    "plugin",
    "security",
    "audit",
    "appsec",
    "vibe-coding",
    "supabase",
    "nextjs",
    "pentest",
    "code-review"
  ],
  "homepage": "https://github.com/Aayan15728/boring-security#readme",
  "bugs": {
    "url": "https://github.com/Aayan15728/boring-security/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aayan15728/boring-security.git"
  },
  "license": "MIT",
  "bin": {
    "boring-security": "install.cjs"
  },
  "files": [
    "install.cjs",
    ".claude-plugin/",
    "agents/",
    "commands/",
    "hooks/hooks.json",
    "hooks/*.cjs",
    "skills/",
    "!skills/boring-security/scripts/test/",
    "docs/",
    "INSTALL.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CREDITS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test skills/boring-security/scripts/test/validators.test.cjs skills/boring-security/scripts/test/detector.test.cjs skills/boring-security/scripts/test/score.test.cjs skills/boring-security/scripts/test/run-state.test.cjs skills/boring-security/scripts/test/brief.test.cjs skills/boring-security/scripts/test/inventory.test.cjs skills/boring-security/scripts/test/sarif.test.cjs skills/boring-security/scripts/test/sandbox-probe.test.cjs hooks/test/bsec-pretool.test.cjs hooks/test/secret-guard.test.cjs bench/test/bench.test.cjs tests/install.test.cjs skills/boring-security/scripts/test/cross-repo.test.cjs skills/boring-security/scripts/test/orchestrate.test.cjs",
    "detect": "node skills/boring-security/scripts/detect.cjs",
    "bench": "node bench/detector-bench.cjs",
    "inventory": "node skills/boring-security/scripts/inventory.cjs"
  }
}
